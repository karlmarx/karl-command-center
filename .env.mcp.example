# Template for the /api/mcp env vars. Copy to .env.mcp.local (gitignored),
# fill in REAL values, then run:  bash scripts/setup-vercel-env.sh
#
# Do NOT commit .env.mcp.local.

# Shared bearer that gates the whole endpoint. Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

# GitHub PAT with `repo` scope (github_create_issue / github_recent_merges).
GITHUB_TOKEN=

# Todoist developer API token (todoist_create_task).
TODOIST_TOKEN=

# Twilio (twilio_send_urgent_sms). Same values as the Mac runner's
# services/email-triage/.env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# Dedicated read-only Neon role for lookup_nwbfit_user_activity.
# Build this from db/nwbfit-readonly-role.sql — same host as your existing
# NWB_POSTGRES_URL, with the nwbfit_readonly user/password.
# postgresql://nwbfit_readonly:<password>@<same-pooler-host>/neondb?sslmode=require
NWB_POSTGRES_READONLY_URL=
